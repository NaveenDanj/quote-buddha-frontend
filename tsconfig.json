{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@ds/*": ["./src/design-system/*"],
      "@components/*": ["./src/components/*"],
      "@templates/*": ["./src/templates/*"],
      "@pages/*": ["./src/pages/*"],
      "@api/*": ["./src/api/*"],
      "@wording": ["./src/wording"],
      "@wording/*": ["./src/wording/*"],
      "@keyboard": ["./src/keyboard"],
      "@domain": ["./src/domain"],
      "@domain/*": ["./src/domain/*"],
      "@test/*": ["./src/test/*"]
    }
  },
  "include": ["src", ".storybook", "vite.config.ts"]
}
